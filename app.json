      },
      "package": "com.muhsantracker.dailytracker",
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#0a0a0f"
    },
    "extra": {
      "eas": {
        "projectId": "ad3fd03e-e825-47fa-9992-76f586fc3eb1"
      }
    },
    "owner": "muhsan"
